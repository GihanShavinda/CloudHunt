# Copy to .env for local dev. NEVER commit real secrets.
CLOUDHUNT_ENV=dev
CLOUDHUNT_JWT_SECRET=dev-only-insecure-change-me
CLOUDHUNT_TOKEN_MINUTES=60
CLOUDHUNT_DEV_SEED=true

# Ingestion sources
AWS_DEFAULT_REGION=us-east-1
CLOUDHUNT_LOCALSTACK_URL=http://localstack:4566
CLOUDHUNT_SQS_URL=

# Backing services (used from Milestone 2+)
POSTGRES_USER=cloudhunt
POSTGRES_PASSWORD=cloudhunt
POSTGRES_DB=cloudhunt
NEO4J_AUTH=neo4j/cloudhunt

# P12 optional production adapters (leave blank for deterministic in-memory dev/test)
CLOUDHUNT_DATABASE_URL=
CLOUDHUNT_REDIS_URL=redis://localhost:6379/0
CLOUDHUNT_NEO4J_URI=bolt://localhost:7687
CLOUDHUNT_NEO4J_USER=neo4j
CLOUDHUNT_NEO4J_PASSWORD=cloudhunt
CLOUDHUNT_ASSISTANT_ENABLED=false
